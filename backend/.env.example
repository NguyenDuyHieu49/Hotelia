# Environment
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://admin:password@localhost:27017/hotelia?authSource=admin

# JWT
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# One-time admin bootstrap. Leave blank after the admin account exists.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Server-side integrations. Never expose these through VITE_ variables or an iOS bundle.
OPENWEATHER_API_KEY=

# payOS payment channel credentials (keep real values only in backend/.env)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Deep links used by the iOS app after hosted checkout.
PAYOS_RETURN_URL=hotelia://payment/success
PAYOS_CANCEL_URL=hotelia://payment/cancel

# Comma-separated browser origins allowed by CORS. Required in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Native iOS sign-in token audiences (public OAuth client identifiers, not secrets)
GOOGLE_IOS_CLIENT_ID=170450615011-834qjphaod1cgeitsic6k6jqvdn1gh87.apps.googleusercontent.com
APPLE_BUNDLE_ID=HieuNguyen.DuLich
